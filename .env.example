# Copy this file to .env and fill in what you need. Everything here is optional.

# MyMemory (default translator, no key needed). Adding an email raises the
# free limit from 5,000 to 50,000 characters per day.
MYMEMORY_EMAIL=

# Microsoft Translator (Azure). If a key is set, it is used first and
# MyMemory becomes the backup.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Set to 1 for auto-reload and detailed errors while developing.
FLASK_DEBUG=0
